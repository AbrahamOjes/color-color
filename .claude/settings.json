{
  "permissions": {
    "deny": [
      "Read(./contracts/.env)",
      "Read(./frontend/.env.local)",
      "Read(./frontend/.env.local.amoy-backup)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(~/.foundry/keystores/**)",
      "Bash(cast wallet decrypt-keystore:*)",
      "Bash(cast wallet private-key:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-tx.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
