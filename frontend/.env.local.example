# WalletConnect project ID (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# Which chain the app reads: polygon | amoy | local. The first chain in Web3Provider's list
# is wagmi's default for reads with no wallet connected, so this MUST match where the
# addresses below live; a mismatch makes every read silently return nothing.
NEXT_PUBLIC_CHAIN=local

# RPC URLs. These are shipped to the browser (NEXT_PUBLIC_), so use a key you can rotate
# and restrict by origin, never a key shared with the keeper or scripts.
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Contract addresses (update after deployment).
# Verify each one with `cast code <addr>` before trusting it: an address that is right at the
# prefix and wrong at the tail looks correct at a glance.
# Games shown in the lobby, in order. Either a comma list of id:address
#   NEXT_PUBLIC_GAMES=colorcolor:0x...,greyhounds:0x...
# or a JSON array, which can also override the title and tagline
#   NEXT_PUBLIC_GAMES=[{"id":"colorcolor","address":"0x..."}]
# Known ids: colorcolor, greyhounds, danfo, okada, keke, horses, race (src/games/registry.ts).
NEXT_PUBLIC_GAMES=
# Fallback while migrating: used for ColorColor only when NEXT_PUBLIC_GAMES is unset or empty.
NEXT_PUBLIC_COLORCOLOR_ADDRESS=0x...
NEXT_PUBLIC_HOUSE_VAULT_ADDRESS=0x...
NEXT_PUBLIC_REFERRAL_MANAGER_ADDRESS=0x...
NEXT_PUBLIC_USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# Transak API key (optional fiat on-ramp)
NEXT_PUBLIC_TRANSAK_API_KEY=your_transak_key

# Server-only. When set, the whole site sits behind HTTP Basic Auth (any username).
# Leave unset locally. Not NEXT_PUBLIC_: it never reaches the browser bundle.
SITE_PASSWORD=
