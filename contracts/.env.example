# NO PRIVATE KEYS IN THIS FILE. See contracts/KEYS.md.
#
# Create an encrypted keystore once:
#   cast wallet new ~/.foundry/keystores deployer
# then pass --account deployer to forge/cast. The key is never written in plaintext,
# so there is nothing here for a clipboard reader or a file scanner to take.

# Treasury address (defaults to deployer if not set)
TREASURY=0x...

# RPC URLs. Scripts read RPC_URL; the chain-specific names are kept for the deploy scripts.
RPC_URL=http://127.0.0.1:8545
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Token. Amoy test USDC below; deploy scripts assert this address has code.
USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# Chainlink VRF v2.5 (Polygon Amoy)
VRF_COORDINATOR=0x343300b5d84D444B2ADc9116FEF1bED02BE49Cf2
VRF_SUBSCRIPTION_ID=1234
VRF_KEY_HASH=0x816bedba8a50b294e5cbd47842baf240c2385f2eaf719edbd4f250a137a8c899
VRF_CALLBACK_GAS_LIMIT=2500000
VRF_REQUEST_CONFIRMATIONS=3

# Optional: reuse an existing ReferralManager you own. Leave unset to deploy a fresh one.
# The deploy script asserts its immutable USDC matches USDC_ADDRESS (a mismatch reverts every
# placeBet) and that you own it.
# REFERRAL_MANAGER=0x...

# ColorColor (fixed odds)
COLORCOLOR_DRAW_INTERVAL=180

# House edge in bps, priced into every payout multiplier. 800 = 8%.
# Of the gross stake, 2% goes to referrals and 1% to treasury; the rest of the edge is the
# vault's expected margin.
COLORCOLOR_HOUSE_EDGE_BPS=800

# Hard cap on a single bet's payout, in USDC (6dp). Mandatory: the rarest RAINBOW outcome
# pays over 13,000x, so without this a $1 bet could obligate the house for five figures.
COLORCOLOR_MAX_PAYOUT=1000000000

# Worst-case draw liability allowed, as bps of the bankroll. Start low and raise it as the
# vault grows.
COLORCOLOR_MAX_EXPOSURE_BPS=2000
