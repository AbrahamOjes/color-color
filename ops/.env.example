# Shared by the ops services. No keys here; signers come from Foundry keystores.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Games as JSON or id:address[:kind] with kind colorcolor (default) or race.
GAMES=colorcolor:0x...,greyhounds:0x...:race
HOUSE_VAULT_ADDRESS=0x...
VRF_COORDINATOR=0x...
AGENT_MANDATE_ADDRESS=0x...
KEEPER_ADDRESS=0x...
# Alert thresholds. Runway in draws (VRF) and transactions (keeper gas).
VRF_MIN_RUNWAY_DRAWS=50
VRF_COST_PER_DRAW_WEI=260000000000000000
KEEPER_MIN_RUNWAY_TXS=100
KEEPER_GAS_PER_TX=300000
